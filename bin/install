#!/usr/bin/env bash
# Add this checkout's hooks to ~/.cursor/hooks.json, keeping any other hooks.
resolve_dir() {
  local source=$1
  while [ -L "$source" ]; do
    local dir target
    dir=$(cd "$(dirname "$source")" && pwd -P)
    target=$(readlink "$source")
    case "$target" in
      /*) source=$target ;;
      *) source=$dir/$target ;;
    esac
  done
  cd "$(dirname "$source")" && pwd -P
}

fail() {
  printf 'install: %s\n' "$1" >&2
  exit 1
}

bin_dir=$(resolve_dir "$0")
cursor_dir=$HOME/.cursor
dest=$cursor_dir/hooks.json

command -v jq >/dev/null 2>&1 && jq -n . >/dev/null 2>&1 || fail 'jq not found'
mkdir -p "$cursor_dir" || fail "cannot create $cursor_dir"

current='{}'
if [ -s "$dest" ]; then
  current=$(cat "$dest") || fail "cannot read $dest"
fi

# Merge our hooks into the current file. For each event in the list, append
# {"command": "<bin>/<script>"} unless that exact command is already there.
# Other hooks and keys are kept. jq fails, leaving the file untouched, if the
# version is not 1 or the file does not have the expected shape.
merged=$(printf '%s' "$current" | jq --arg bin "$bin_dir" '
  def add($event; $cmd):
    .hooks[$event] |= ((. // []) | if any(.[]; .command? == $cmd) then . else . + [{command: $cmd}] end);
  if has("version") and .version != 1 then error("unsupported version") else . end
  | .version = 1
  | reduce (
      ["stop", "notify-on-stop"],
      ["beforeShellExecution", "notify-on-approval"],
      ["beforeMCPExecution", "notify-on-approval"]
    ) as [$event, $script] (.; add($event; $bin + "/" + $script))
') || fail "cannot update $dest; left unchanged"

tmp=$(mktemp "$dest.XXXXXX") || fail "cannot write to $cursor_dir"
if ! printf '%s\n' "$merged" > "$tmp" || ! mv "$tmp" "$dest"; then
  rm -f "$tmp"
  fail "cannot write $dest"
fi
