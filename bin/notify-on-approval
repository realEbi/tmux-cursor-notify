#!/usr/bin/env bash
# Cursor beforeShellExecution / beforeMCPExecution: notify when the CLI approval card is on screen.
# Prints {} and does not set permission — this hook abstains from the merge (see hooks.md).
input=$(cat || true)

# No permission field: observational only; Cursor client / other hooks still enforce approval.
HOOK_OUT='{}'

finish() {
  printf '%s\n' "$HOOK_OUT"
  exit 0
}

shell_quote() {
  local escaped
  escaped=${1//\'/\'\\\'\'}
  printf "'%s'" "$escaped"
}

workspace_body() {
  local p=$1
  if [ -z "$p" ]; then
    printf '%s' agent
    return
  fi
  while [ -n "$p" ] && [ "$p" != "${p%/}" ]; do
    p=${p%/}
  done
  if [ -z "$p" ]; then
    printf '%s' agent
    return
  fi
  local base=${p##*/}
  if [ -z "$base" ]; then
    printf '%s' agent
  else
    printf '%s' "$base"
  fi
}

truncate_body() {
  local text=$1
  local max=${2:-80}
  if [ "${#text}" -le "$max" ]; then
    printf '%s' "$text"
    return
  fi
  local cut=$((max - 1))
  printf '%s…' "${text:0:$cut}"
}

JQ_FILTER='
if type != "object" then
  "BAD"
else
  "META",
  ("conv=" + (if (.conversation_id | type) == "string" then .conversation_id else "" end)),
  ("root=" + (if (.workspace_roots | type) == "array" and (.workspace_roots[0] | type) == "string" then .workspace_roots[0] else "" end)),
  ("snippet=" + (
    if (.command | type) == "string" then .command
    elif (.tool_name | type) == "string" and (.tool_name | length) >= 8 then .tool_name
    elif (.tool_name | type) == "string" and (.tool_input | type) == "string" and (.tool_input | length) >= 8 then .tool_input
    elif (.tool_input | type) == "string" then .tool_input
    else ""
    end
  ))
end
'

PY_FILTER='
import json, sys
raw = sys.stdin.read()
try:
    data = json.loads(raw) if raw.strip() != "" else None
except Exception:
    sys.stdout.write("BAD\n")
    raise SystemExit(0)
if not isinstance(data, dict):
    sys.stdout.write("BAD\n")
    raise SystemExit(0)
conv = data.get("conversation_id", "")
if not isinstance(conv, str):
    conv = ""
roots = data.get("workspace_roots", None)
root = ""
if isinstance(roots, list) and roots and isinstance(roots[0], str):
    root = roots[0]
snippet = ""
cmd = data.get("command", None)
if isinstance(cmd, str):
    snippet = cmd
else:
    tool = data.get("tool_name", None)
    tin = data.get("tool_input", None)
    if isinstance(tool, str) and len(tool) >= 8:
        snippet = tool
    elif isinstance(tool, str) and isinstance(tin, str) and len(tin) >= 8:
        snippet = tin
    elif isinstance(tin, str):
        snippet = tin
    elif isinstance(tool, str):
        snippet = tool
sys.stdout.write("META\n")
sys.stdout.write("conv=%s\n" % conv)
sys.stdout.write("root=%s\n" % root)
sys.stdout.write("snippet=%s\n" % snippet)
'

parsed=
decided=
if command -v jq >/dev/null 2>&1; then
  parsed=$(printf '%s' "$input" | jq -r "$JQ_FILTER" 2>/dev/null)
  rc=$?
  if [ "$rc" -eq 0 ]; then
    decided=1
  elif [ "$rc" -ne 127 ]; then
    parsed=BAD
    decided=1
  fi
fi
if [ -z "$decided" ] && command -v python3 >/dev/null 2>&1; then
  parsed=$(printf '%s' "$input" | python3 -c "$PY_FILTER" 2>/dev/null)
  rc=$?
  if [ "$rc" -eq 0 ]; then
    decided=1
  elif [ "$rc" -ne 127 ]; then
    parsed=BAD
    decided=1
  fi
fi
if [ -z "$decided" ]; then
  parsed=BAD
fi

action=$(printf '%s\n' "$parsed" | head -n 1)
conv=
root=
snippet=
if [ "$action" = "META" ]; then
  while IFS= read -r line; do
    case "$line" in
      conv=*) conv=${line#conv=} ;;
      root=*) root=${line#root=} ;;
      snippet=*) snippet=${line#snippet=} ;;
    esac
  done <<PARSE
$parsed
PARSE
fi

title='Cursor needs approval'
body=
group=cursor-unknown
if [ -n "$snippet" ]; then
  body=$(truncate_body "$snippet" 80)
else
  body=$(workspace_body "$root")
fi
if [ -n "$conv" ]; then
  group="cursor-$conv"
fi

if [ -z "${TMUX_PANE-}" ]; then
  finish
fi

bin_dir=$(cd "$(dirname "$0")" && pwd -P)
focus_pane="$bin_dir/focus-pane"
bundle=${__CFBundleIdentifier-}
socket=
if [ -n "${TMUX-}" ]; then
  socket=${TMUX%%,*}
fi

delay=${NOTIFY_APPROVAL_DELAY:-0.4}

export NOTIFY_APPROVAL_TITLE="$title"
export NOTIFY_APPROVAL_BODY="$body"
export NOTIFY_APPROVAL_GROUP="$group"
export NOTIFY_APPROVAL_SNIPPET="$snippet"
export NOTIFY_APPROVAL_FOCUS_PANE="$focus_pane"
export NOTIFY_APPROVAL_BUNDLE="$bundle"
export NOTIFY_APPROVAL_SOCKET="$socket"
export NOTIFY_APPROVAL_PANE="$TMUX_PANE"
export NOTIFY_APPROVAL_DELAY="$delay"
export TMUX=${TMUX-}

worker=$(mktemp "${TMPDIR:-/tmp}/notify-approval-worker.XXXXXX")
cat > "$worker" << 'WORKER'
#!/usr/bin/env bash
trap 'unlink -- "$0" 2>/dev/null || true' EXIT
title=${NOTIFY_APPROVAL_TITLE-}
body=${NOTIFY_APPROVAL_BODY-}
group=${NOTIFY_APPROVAL_GROUP-}
snippet=${NOTIFY_APPROVAL_SNIPPET-}
focus_pane=${NOTIFY_APPROVAL_FOCUS_PANE-}
bundle=${NOTIFY_APPROVAL_BUNDLE-}
socket=${NOTIFY_APPROVAL_SOCKET-}
pane=${NOTIFY_APPROVAL_PANE-}
delay=${NOTIFY_APPROVAL_DELAY:-0.4}

shell_quote() {
  local escaped
  escaped=${1//\'/\'\\\'\'}
  printf "'%s'" "$escaped"
}

# Approval UI strings from cursor-agent 2026.09.28-64d2043/6949.index.js (shell/MCP decision prompts).
pane_has_approval_marker() {
  local text=$1
  case "$text" in
    *'Run this command?'*) return 0 ;;
    *'Run this command outside the sandbox?'*) return 0 ;;
    *'Run this MCP tool?'*) return 0 ;;
      esac
  return 1
}

pane_matches_snippet() {
  local text=$1
  local snip=$2
  local normalized needle
  if [ -z "$snip" ]; then
    return 0
  fi
  if [ "${#snip}" -lt 8 ]; then
    return 0
  fi
  # Drop newlines so a command wrapped across pane rows still matches.
  normalized=$(printf '%s' "$text" | tr -d '\n')
  needle=$(printf '%s' "$snip" | tr -d '\n')
  needle=${needle:0:24}
  printf '%s' "$normalized" | grep -F -q -- "$needle"
}

terminal_is_front() {
  local bundle front
  bundle=${__CFBundleIdentifier-}
  if [ -n "$bundle" ] && ! printf '%s' "$bundle" | grep -q '["\\]'; then
    front=$(osascript -e 'tell application "System Events" to get bundle identifier of first application process whose frontmost is true') || return 1
    front=$(printf '%s' "$front" | sed 's/[[:space:]]*$//')
    [ "$front" = "$bundle" ]
    return
  fi
  front=$(osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true') || return 1
  front=$(printf '%s' "$front" | sed 's/[[:space:]]*$//')
  case "$front" in
    Terminal|iTerm2|Ghostty|WezTerm|kitty|Alacritty) return 0 ;;
    *) return 1 ;;
  esac
}

pane_is_visible() {
  local out socket fmt a b c
  fmt='#{pane_active} #{window_active} #{session_attached}'
  socket=
  if [ -n "${TMUX-}" ]; then
    socket=${TMUX%%,*}
  fi
  if [ -n "$socket" ]; then
    out=$(tmux -S "$socket" display-message -p -t "$pane" "$fmt") || return 1
  else
    out=$(tmux display-message -p -t "$pane" "$fmt") || return 1
  fi
  out=$(printf '%s' "$out" | sed 's/[[:space:]]*$//')
  set -- $out
  [ "$#" -eq 3 ] || return 1
  a=$1
  b=$2
  c=$3
  [ "$a" = "1" ] && [ "$b" = "1" ] || return 1
  printf '%s' "$c" | grep -Eq '^[0-9]+$' || return 1
  [ "$c" -ge 1 ]
}

sleep "$delay" || true

polls=${NOTIFY_APPROVAL_POLLS:-240}
interval=${NOTIFY_APPROVAL_INTERVAL:-0.5}
appear=${NOTIFY_APPROVAL_APPEAR_POLLS:-40}
seen=0
poll_count=0
no_marker_count=0

while [ "$poll_count" -lt "$polls" ]; do
  capture=
  if [ -n "$socket" ]; then
    capture=$(tmux -S "$socket" capture-pane -p -t "$pane" 2>/dev/null) || capture=
  else
    capture=$(tmux capture-pane -p -t "$pane" 2>/dev/null) || capture=
  fi

  tail_lines=$(printf '%s\n' "$capture" | tail -n 15)
  tail_blob=$(printf '%s' "$tail_lines")

  if pane_has_approval_marker "$tail_blob"; then
    if pane_matches_snippet "$tail_blob" "$snippet"; then
      seen=1
      if ! terminal_is_front || ! pane_is_visible; then
        break
      fi
    else
      exit 0
    fi
  else
    if [ "$seen" -eq 1 ]; then
      exit 0
    fi
    no_marker_count=$((no_marker_count + 1))
    if [ "$no_marker_count" -ge "$appear" ]; then
      exit 0
    fi
  fi

  poll_count=$((poll_count + 1))
  if [ "$poll_count" -ge "$polls" ]; then
    exit 0
  fi
  sleep "$interval" || true
done

exec_cmd="$(shell_quote "$focus_pane") $(shell_quote "$bundle") $(shell_quote "$socket") $(shell_quote "$pane")"

if ! terminal-notifier -title "$title" -message "$body" -sound Glass -group "$group" -execute "$exec_cmd"; then
  osascript -e 'on run argv
  display notification (item 2 of argv) with title (item 1 of argv) sound name (item 3 of argv)
end run' -- "$title" "$body" Glass || true
fi
WORKER
chmod +x "$worker" || {
  unlink -- "$worker" 2>/dev/null || true
  finish
}

spawn_worker_detached() {
  local w=$1
  # Wait until the child has called setsid, and point its stdio at /dev/null
  # so a delay of 0 cannot write onto the hook's stdout.
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$w" >/dev/null 2>&1 <<'PYSPAWN'
import os, sys
worker = sys.argv[1]
read_fd, write_fd = os.pipe()
pid = os.fork()
if pid < 0:
    sys.exit(1)
if pid == 0:
    os.close(read_fd)
    try:
        os.setsid()
    except OSError:
        os._exit(1)
    os.write(write_fd, b"1")
    os.close(write_fd)
    try:
        os.execv(worker, [worker])
    except OSError:
        os._exit(1)
os.close(write_fd)
got = os.read(read_fd, 1)
os.close(read_fd)
sys.exit(0 if got == b"1" else 1)
PYSPAWN
    return $?
  fi
  if command -v perl >/dev/null 2>&1; then
    perl -MPOSIX -e 'pipe(R, W); my $pid = fork(); exit 1 if !defined $pid; if ($pid == 0) { close R; POSIX::setsid(); print W "1"; close W; exec @ARGV or exit 1; } close W; my $b = ""; sysread(R, $b, 1); exit($b eq "1" ? 0 : 1);' "$w" >/dev/null 2>&1
    return $?
  fi
  nohup "$w" >/dev/null 2>&1 &
}

if ! spawn_worker_detached "$worker"; then
  unlink -- "$worker" 2>/dev/null || true
fi

finish
