#!/usr/bin/env bash
# Cursor beforeShellExecution / beforeMCPExecution hook: notify when the CLI
# shows an approval card in this tmux pane and you are not looking at it.
# Always answers {}, so Cursor's own approval rules decide; this hook only watches.
. "$(cd "$(dirname "$0")" && pwd -P)/lib.sh"

# Card titles from cursor-agent 2026.09.28 (6949.index.js).
card_is_shown() {
  case "$1" in
    *'Run this command?'* | *'Run this command outside the sandbox?'* | *'Run this MCP tool?'*) return 0 ;;
  esac
  return 1
}

# True when the first 24 characters of the command are on screen, so a card for
# a different command does not count. Commands under 8 characters are not checked.
card_is_for() {
  local screen=${1//$'\n'/} cmd=${2//$'\n'/}
  [ "${#cmd}" -lt 8 ] && return 0
  [[ $screen == *"${cmd:0:24}"* ]]
}

# Background watcher: wait for the card, then notify once you look away.
# Stops quietly if the card goes away, a different card shows, or time runs out.
watch() {
  local pane=$1 cmd=$2 group=$3
  local interval=${NOTIFY_APPROVAL_INTERVAL:-0.5}
  local polls=${NOTIFY_APPROVAL_POLLS:-240}
  local appear=${NOTIFY_APPROVAL_APPEAR_POLLS:-40}
  local seen=0 i screen body

  sleep "${NOTIFY_APPROVAL_DELAY:-0.4}"
  for ((i = 0; i < polls; i++)); do
    [ "$i" -gt 0 ] && sleep "$interval"
    screen=$(tmux_cmd capture-pane -p -t "$pane" 2>/dev/null | tail -n 15)
    if card_is_shown "$screen"; then
      card_is_for "$screen" "$cmd" || return 0
      seen=1
      if ! terminal_is_front || ! pane_is_visible "$pane"; then
        body=${cmd:-agent}
        [ "${#body}" -gt 80 ] && body="${body:0:79}…"
        notify 'Cursor needs approval' "$body" "$group" "$pane"
        return 0
      fi
    elif [ "$seen" = 1 ] || [ $((i + 1)) -ge "$appear" ]; then
      return 0
    fi
  done
}

if [ "${1-}" = --watch ]; then
  shift
  watch "$@"
  exit 0
fi

input=$(cat)
if [ -n "${TMUX_PANE-}" ]; then
  cmd= conv=
  # Shell calls carry "command"; MCP calls carry "tool_name".
  eval "$(printf '%s' "$input" | jq -r '@sh "cmd=\(.command // .tool_name // "" | tostring) conv=\(.conversation_id // "" | tostring)"' 2>/dev/null)"
  # Run this script again as the watcher, in its own session so it outlives the
  # hook. Its output goes to /dev/null so Cursor does not wait for it.
  perl -MPOSIX -e 'defined(my $pid = fork) or exit 1; if ($pid) { exit } setsid; exec @ARGV' \
    "$0" --watch "$TMUX_PANE" "$cmd" "cursor-${conv:-unknown}" </dev/null >/dev/null 2>&1
fi
printf '{}\n'
