#!/usr/bin/env bash
# Cursor stop hook: notify when a CLI turn in a tmux pane completes or fails.
. "$(cd "$(dirname "$0")" && pwd -P)/lib.sh"
input=$(cat)

if [ -n "${TMUX_PANE-}" ]; then
  status= conv= folder=
  # The folder is the last part of the first workspace path, e.g. /a/b/ -> b.
  eval "$(printf '%s' "$input" | jq -r '
    @sh "status=\(.status | strings // "")",
    @sh "conv=\(.conversation_id | strings // "")",
    @sh "folder=\(.workspace_roots[0]? | strings | sub("/+$"; "") | split("/") | last // "")"
  ' 2>/dev/null)"

  case $status in
    completed) title='Cursor finished' ;;
    error) title='Cursor hit an error' ;;
    *) title= ;;
  esac

  # Stay quiet when you are already looking at this pane.
  if [ -n "$title" ] && ! { terminal_is_front && pane_is_visible "$TMUX_PANE"; }; then
    notify "$title" "${folder:-agent}" "cursor-${conv:-unknown}" "$TMUX_PANE"
  fi
fi
printf '{}\n'
